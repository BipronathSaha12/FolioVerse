# ==============================================================================
# FolioVerse Environment Variables Template (.env.example)
# Copy to .env and configure values before starting the application.
# NEVER commit .env to source control.
# ==============================================================================

# Core Application Settings
DEBUG=False
SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost,your-production-domain.com

# CORS Allowed Origins (Comma-separated list of trusted client origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Transport & SSL Redirect (Set to True in production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database Configuration (Neon PostgreSQL or Local PostgreSQL)
# Option A: Full Connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/folioverse_db

# Option B: Individual Database Parameters (fallback if DATABASE_URL not set)
DB_NAME=folioverse_db
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password
DB_HOST=localhost
DB_PORT=5432
