# ==============================================================================
# FolioVerse Root Environment Variables Reference
# Backend configuration belongs in backend/.env
# Frontend configuration belongs in frontend/.env
# ==============================================================================

# Backend (Django REST Framework)
DEBUG=False
SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost,your-production-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
DATABASE_URL=postgresql://user:password@localhost:5432/folioverse_db

# Frontend (Vite + React)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
